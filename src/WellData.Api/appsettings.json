{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning",
        "System.Net.Http.HttpClient": "Warning",
        "Polly": "Warning"
      }
    }
  },
  "AllowedHosts": "*",
  "Jwt": {
    "Issuer": "WellData.Api",
    "Audience": "WellData.Api",
    "ExpiryMinutes": 60
  },
  "Petrinex": {
    "BaseUrl": "https://www.petrinex.gov.ab.ca/publicdata/API/Files/AB/",
    "CacheDirectory": "../../data/cache",
    "OperatorBaIds": [ "0026", "0XZ4", "A04N", "A5BE", "0YA2", "A2TG", "A7BT", "0RL9", "A6FW", "0G30", "0BP8" ]
  },
  "IngestionScheduler": {
    "Enabled": true,
    "Interval": "06:00:00",
    "LookbackMonths": 4
  },
  "ErpExport": {
    "Directory": "../../exports"
  },
  "Validation": {
    "SpikeThresholdPercent": 300,
    "MinimumVolume": 5,
    "OutlierStandardDeviations": 3,
    "MinimumHistoryMonths": 6,
    "MaxWaterCut": 0.99,
    "MaxGasOilRatio": 20000
  }
}
