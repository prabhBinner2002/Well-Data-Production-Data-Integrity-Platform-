<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\WellData.Core\WellData.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="CsvHelper" Version="33.1.0" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" Version="10.0.12" />
    <PackageReference Include="Microsoft.Extensions.Http.Resilience" Version="10.10.0" />
  </ItemGroup>

  <ItemGroup>
    <!-- The .sql files in /sql are the source of truth, embedded so migrations and services can run them. -->
    <EmbeddedResource Include="..\..\sql\**\*.sql" LinkBase="Sql" LogicalName="Sql/%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>

</Project>
